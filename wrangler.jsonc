{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koenma-id",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "KoenmaIdContainer",
      "image": "./Dockerfile",
      "max_instances": 3,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KOENMA_ID_CONTAINER",
        "class_name": "KoenmaIdContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KoenmaIdContainer"]
    }
  ]
}
